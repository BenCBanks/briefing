{
  "version": 1,
  "fallback_tags": ["digital"],
  "rules": [
    {"match_any": ["ai chips", "semiconductor", "semiconductors", "chip manufacturing"], "tags": ["semiconductors", "ai", "digital"]},
    {"match_any": ["ai", "artificial intelligence"], "tags": ["ai", "finance", "digital", "payments"]},
    {"match_any": ["climate policy", "climate", "climate change", "clean energy"], "tags": ["climate-policy", "energy", "science"]},
    {"match_any": ["space launch", "space launches", "spaceflight", "rocket launch"], "tags": ["space", "science", "digital"]},
    {"match_any": ["payments", "payment", "banking"], "tags": ["payments", "banking", "finance"]},
    {"match_any": ["ai in finance", "artificial intelligence finance"], "tags": ["ai", "finance", "digital", "payments"]},
    {"match_any": ["health finance policy", "health policy finance"], "tags": ["health", "finance"]},
    {"match_any": ["health insurance", "medicaid", "medicare", "insurance policy"], "tags": ["insurance", "health"]},
    {"match_any": ["health"], "tags": ["insurance", "health"]},
    {"match_any": ["affordable housing", "rent"], "tags": ["housing-market", "affordable-housing"]},
    {"match_any": ["home building", "homebuilding", "construction", "building materials"], "tags": ["housing-market", "homebuilding", "construction", "materials"]},
    {"match_any": ["housing"], "tags": ["housing-market"]}
  ]
}
