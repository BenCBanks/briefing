      "chapters": [
        {
          "id": "why-change",
          "title": "Why the city is changing its rules",
          "sentences": [
            {
              "text": "The fictional city plans to connect several local banks to a shared instant payment network.",
              "source_ids": [
                "pay-1"
              ]
            },
            {
              "text": "The draft rule asks each bank to confirm receipt before describing a transfer as complete.",
              "source_ids": [
                "pay-2"
              ]
            }
          ],
          "start_seconds": 0,
          "end_seconds": 1
        },
        {
          "id": "bank-response",
          "title": "How banks are responding",
          "sentences": [
            {
              "text": "Two fictional lenders say they will begin with small business payments and extend the service later.",
              "source_ids": [
                "pay-3",
                "pay-4"
              ]
            },
            {
              "text": "A public consultation remains open until the end of the month.",
              "source_ids": [
                "pay-5"
              ]
            }
          ],
          "start_seconds": 1,
          "end_seconds": 2
        },
        {
          "id": "what-changes",
          "title": "What could change for customers",
          "sentences": [
            {
              "text": "The pilot would add a receipt step for participating transfers while leaving other payment methods unchanged.",
              "source_ids": [
                "pay-2"
              ]
            }
          ],
          "start_seconds": 2,
          "end_seconds": 3
